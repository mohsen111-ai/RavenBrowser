 long-clickable="false" password="false" selected="false" bounds="[24,150][296,265]" drawing-order="0" hint=""><node index="0" text="Le grand corbeau" resource-id="" class="android.view.View" package="app.raven.browser" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[24,157][165,258]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="app.raven.browser" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[24,289][296,577]" drawing-order="0" hint=""><node index="0" text="Le grand corbeau est un grand oiseau de la famille des corvidés. Il vit dans les montagnes, les forêts et les falaises de tout l'hémisphère Nord. C'est l'un des oiseaux les plus intelligents du monde : il sait résoudre des problèmes, utiliser des outils et se souvenir des visages humains pendant des années." resource-id="" class="android.view.View" package="app.raven.browser" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[24,293][290,574]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="app.raven.browser" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[24,595][296,640]" drawing-order="0" hint=""><node index="0" text="Les corbeaux vivent souvent en couple toute leur vie. Ils construisent leur nid au sommet des arbres ou sur les rochers, et ils parlent entre eux avec des dizaines de cris différents. Dans de nombreuses légendes, le corbeau est le messager entre le monde des vivants et celui des esprits." resource-id="" class="android.view.View" package="app.raven.browser" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[24,599][284,640]" drawing-order="0" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>